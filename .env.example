# Copy to .env and replace this value with a unique key before starting Compose.
DRAVENPDF_API_KEY=replace-with-a-unique-random-key

# Host-side port. Compose binds it to 127.0.0.1 by default.
DRAVENPDF_PORT=8000

# Each worker has its own Chromium pool. Increase only when memory allows.
DRAVENPDF_WORKERS=1
DRAVENPDF_MAX_CONCURRENCY=2
