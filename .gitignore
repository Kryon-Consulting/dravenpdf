# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.dmypy.json

# Packaging and build output
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/

# Test and coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
# Image diffs from failed visual tests (reference images ARE committed)
tests/visual/__diff__/

# Environment and secrets
.env
.env.*
!.env.example

# Generated PDFs and images from local runs (test fixtures under tests/fixtures are committed)
/out/
/output/
/outputs/
/images/
*.pdf
!tests/fixtures/**/*.pdf
!examples/**/*.pdf

# Playwright
/playwright-report/
/test-results/
/playwright/.cache/

# Logs and runtime files
logs/
*.log
*.pid

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
